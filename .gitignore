# Maven build output
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.jar
*.war
*.ear
*.class

# Maven wrapper binary (generated on first build)
.mvn/wrapper/maven-wrapper.jar

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# OS files
.DS_Store
Thumbs.db

# Docker bind-mount data volumes
data/postgres/
data/redis/

# Log files
*.log
logs/

# Environment-specific configs (do not commit secrets)
*.env
.env

# Spring Boot devtools
.factorypath
